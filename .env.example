# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Base de datos ----
# Local:  postgres://postgres:postgres@localhost:5432/whatswv
# Neon:   postgres://user:pass@ep-xxx.neon.tech/wati?sslmode=require
DATABASE_URL=

# ---- Meta / WhatsApp Cloud API ----
# Version del Graph API. Revisa la vigente en developers.facebook.com/docs/graph-api/changelog
# Identificador de la app (esta en la URL del panel de Meta). No es secreto.
META_APP_ID=
META_GRAPH_VERSION=v23.0
# WhatsApp > API Setup > "Phone number ID" (NO es el numero de telefono)
META_PHONE_NUMBER_ID=
# WhatsApp > API Setup > "WhatsApp Business Account ID"
META_WABA_ID=
# Token permanente de System User (NO el temporal de 24h)
META_ACCESS_TOKEN=
# App Settings > Basic > App Secret. Se usa para validar la firma del webhook.
META_APP_SECRET=
# Lo inventas tu. Lo pegas igual en la config del webhook en Meta.
META_WEBHOOK_VERIFY_TOKEN=

# ---- Endpoints de prueba (/dev/*) ----
# Inventa una cadena larga. Se manda como header  x-dev-key
DEV_API_KEY=

# Firma los tokens de sesion de los asesores.
JWT_SECRET=

# Tope de conversaciones sin resolver por asesor (ruteo pegajoso).
MAX_CONVERSACIONES_POR_ASESOR=15

# Reparto automatico de clientes nuevos (menor carga). false = todo a la cola manual.
AUTO_ASIGNAR=true
# Minutos sin respuesta antes de devolver a la cola lo que asigno el sistema. 0 desactiva.
RESCATE_MINUTOS=5

# Carpeta de archivos de clientes (fotos, audios, documentos).
ALMACEN_DIR=./almacen
# Tope de subida/descarga en MB. WhatsApp no acepta mas de 16.
MEDIA_MAX_MB=16

# --- Bot automatico ---
BOT_ACTIVO=true
ZONA_HORARIA=America/Bogota
# Formato HH:MM-HH:MM, o "cerrado". Los festivos de Colombia se calculan solos.
HORARIO_LUNES_VIERNES=08:30-17:30
HORARIO_SABADO=08:30-14:00
HORARIO_DOMINGO=cerrado
NEGOCIO_NOMBRE=Repuestos Volkswagen Jhon Pardo
